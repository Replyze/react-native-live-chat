{
  "name": "@replyze/react-native",
  "version": "0.1.0",
  "description": "Live chat and AI support in your React Native or Expo app: the Replyze chat with signed-in users, unread counts, help articles and events.",
  "license": "MIT",
  "type": "commonjs",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "!src/**/__tests__",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:widget": "jest --config jest.widget.config.js",
    "prepare": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "replyze",
    "live-chat",
    "in-app-chat",
    "chat-sdk",
    "customer-support",
    "ai-chatbot",
    "chat-widget",
    "react-native",
    "expo"
  ],
  "homepage": "https://github.com/Replyze/react-native-live-chat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Replyze/react-native-live-chat.git"
  },
  "bugs": {
    "url": "https://github.com/Replyze/react-native-live-chat/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.68.0",
    "react-native-webview": ">=11.0.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-test-renderer": "18.3.0",
    "jest": "29.7.0",
    "jsdom": "24.1.3",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-webview": "13.16.0",
    "react-test-renderer": "18.3.1",
    "ts-jest": "29.2.5",
    "typescript": "5.6.3"
  }
}
