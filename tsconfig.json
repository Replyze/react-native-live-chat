{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2019"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "types": ["jest", "react-native"],
    "baseUrl": ".",
    "paths": { "@replyze/react-native": ["src"] }
  },
  "include": ["src", "__tests__", "example/App.tsx"],
  "exclude": ["node_modules", "lib", "__tests__/*.widget.test.ts"]
}
